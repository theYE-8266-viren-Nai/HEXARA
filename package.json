{
  "name": "horizon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:backend": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "test:db": "node --import ./tests/register.mjs scripts/check-database.mjs",
    "seed:generate": "node --import ./tests/register.mjs scripts/generate-seed.mjs",
    "docs:assumptions": "node --import ./tests/register.mjs scripts/generate-assumptions-doc.mjs",
    "send:sample": "node scripts/send-sample-readings.mjs",
    "setup:pose": "node scripts/setup-pose-assets.mjs",
    "nasa:sync": "node scripts/sync-nasa-corpus.mjs",
    "nasa:benchmark": "node scripts/benchmark-nasa-retrieval.mjs",
    "test:nasa-rls": "node scripts/check-nasa-rls.mjs",
    "test:visual-rls": "node scripts/check-visual-checks-rls.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@tailwindcss/vite": "^4.3.5",
    "lucide-react": "^1.72.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^31.0.0",
    "pdf-parse": "2.4.5",
    "typescript": "^5.8.3",
    "vite": "^7.1.7",
    "vitest": "^5.1.0"
  }
}
