VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional: an organization-approved HTTPS medical communications portal. OrbitWell opens the portal without sending data.
# VITE_GROUND_COMMS_URL=https://your-approved-portal.example
# Optional browser voice layer. These are public Vapi client values, not secret AI keys.
# VITE_VAPI_PUBLIC_KEY=your-vapi-public-key
# VITE_VAPI_ASSISTANT_ID=your-vapi-assistant-id
# AI keys (OPENROUTER_API_KEY + OPENROUTER_MODEL, or ANTHROPIC_API_KEY) are NOT browser variables.
# Set them as Supabase secrets: see docs/explain-setup.md
