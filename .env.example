VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# The Anthropic key is NOT a browser variable. Set it as a Supabase secret: see docs/explain-setup.md
# Optional voice check-in (Vapi): see docs/voice-setup.md. The public key is designed for browsers, so restrict it to your site in the Vapi dashboard.
# VITE_VAPI_PUBLIC_KEY=your-vapi-public-key
# VITE_VAPI_ASSISTANT_ID=your-assistant-id
